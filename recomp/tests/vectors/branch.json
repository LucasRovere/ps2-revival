  {"name": "backward branch loop",
   "asm": ["addiu v0, zero, 0", "L:", "addiu v0, v0, 1", "bne v0, a0, L", "nop"],
   "init": {"a0": "0x3"},
   "expect": {"v0": "0x3", "pc_trace": ["0x00100000", "0x00100004", "0x00100008", "0x0010000c", "0x00100004", "0x00100008",
                                         "0x0010000c", "0x00100004", "0x00100008", "0x0010000c"]}, "source": "spec"},
  {"name": "branch target inside another branch's delay slot",
   "asm": ["addiu t2, zero, 2", "beq t2, zero, OUT", "S:", "addiu v0, v0, 1", "addiu t2, t2, -1", "bgtz t2, S", "nop", "OUT:"],
   "expect": {"v0": "0x2", "t2": "0x0",
              "pc_trace": ["0x00100000", "0x00100004", "0x00100008", "0x0010000c", "0x00100010", "0x00100014",
                           "0x00100008", "0x0010000c", "0x00100010", "0x00100014"]}, "source": "spec"},
  {"name": "j", "asm": ["j L", "addiu v0, zero, 1", "addiu v1, zero, 2", "L:"],
   "expect": {"v0": "0x1", "pc_trace": ["0x00100000", "0x00100004"]}, "source": "spec"},
  {"name": "jal: ra = jal + 8, slot runs before the callee",
   "asm": ["jal F", "addiu a0, zero, 7", "j END", "nop", "F:", "jr ra", "addu v0, a0, a0", "END:"],
   "expect": {"ra": "0x100008", "a0": "0x7", "v0": "0xe",
              "pc_trace": ["0x00100000", "0x00100004", "0x00100010", "0x00100014", "0x00100008", "0x0010000c"]},
   "source": "spec"},
  {"name": "jalr rs links ra", "asm": ["jalr t9", "nop", "j END", "nop", "F:", "jr ra", "nop", "END:"],
   "init": {"t9": "0x100010"},
   "expect": {"ra": "0x100008", "pc_trace": ["0x00100000", "0x00100004", "0x00100010", "0x00100014", "0x00100008", "0x0010000c"]},
   "source": "spec"},
  {"name": "jalr rd, rs links rd", "asm": ["jalr v1, t9", "nop", "j END", "nop", "F:", "jr v1", "addiu v0, zero, 1", "END:"],
   "init": {"t9": "0x100010"},
   "expect": {"v1": "0x100008", "v0": "0x1",
              "pc_trace": ["0x00100000", "0x00100004", "0x00100010", "0x00100014", "0x00100008", "0x0010000c"]},
   "source": "spec"},
  {"name": "jr whose slot writes the target register uses the old value",
   "asm": ["jr t9", "addiu t9, zero, 0", "addiu v0, zero, 1", "addiu v1, zero, 2"],
   "init": {"t9": "0x10000c"}, "expect": {"t9": "0x0", "v1": "0x2", "pc_trace": ["0x00100000", "0x00100004", "0x0010000c"]},
   "source": "spec"},
  {"name": "jalr whose slot writes the target register uses the old value",
   "asm": ["jalr t9", "addiu t9, zero, 0", "addiu v0, zero, 1", "j END", "nop", "F:", "jr ra", "nop", "END:"],
   "init": {"t9": "0x100014"},
   "expect": {"t9": "0x0", "ra": "0x100008", "v0": "0x1",
              "pc_trace": ["0x00100000", "0x00100004", "0x00100014", "0x00100018", "0x00100008", "0x0010000c", "0x00100010"]},
