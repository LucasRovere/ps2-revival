[
  {"name": "beq taken: slot runs, then the target",
   "asm": ["beq a0, a1, L", "addiu v0, zero, 1", "addiu v1, zero, 2", "L:", "addiu t0, zero, 3"],
   "init": {"a0": "0x5", "a1": "0x5"},
   "expect": {"v0": "0x1", "t0": "0x3", "pc_trace": ["0x00100000", "0x00100004", "0x0010000c"]}, "source": "spec"},
  {"name": "beq not taken: slot runs, then the next instruction",
   "asm": ["beq a0, a1, L", "addiu v0, zero, 1", "addiu v1, zero, 2", "L:", "addiu t0, zero, 3"],
   "init": {"a0": "0x1", "a1": "0x2"},
   "expect": {"v0": "0x1", "v1": "0x2", "t0": "0x3", "pc_trace": ["0x00100000", "0x00100004", "0x00100008", "0x0010000c"]},
   "source": "spec"},
  {"name": "beq compares 64 bits",
   "asm": ["beq a0, zero, L", "addiu v0, zero, 1", "addiu v1, zero, 2", "L:", "addiu t0, zero, 3"],
   "init": {"a0": "0x0000000100000000"}, "expect": {"v0": "0x1", "v1": "0x2", "t0": "0x3"}, "source": "spec"},
  {"name": "branch reads its source before the delay slot writes it",
   "asm": ["bne a0, zero, L", "addiu a0, zero, 0", "addiu v1, zero, 2", "L:", "addiu t0, zero, 3"],
   "init": {"a0": "0x1"}, "expect": {"a0": "0x0", "t0": "0x3", "pc_trace": ["0x00100000", "0x00100004", "0x0010000c"]},
   "source": "spec"},
  {"name": "beql taken runs the slot (slot loads the branch's own source)",
   "asm": ["beql a0, zero, L", "lw a0, 4(sp)", "addiu v1, zero, 2", "L:", "addiu t0, zero, 3"],
   "init": {"a0": "0x0", "sp": "0x200000", "mem": {"0x00200004": "07000000"}},
   "expect": {"a0": "0x7", "t0": "0x3", "pc_trace": ["0x00100000", "0x00100004", "0x0010000c"]}, "source": "spec"},
  {"name": "beql not taken skips the slot",
   "asm": ["beql a0, zero, L", "lw a0, 4(sp)", "addiu v1, zero, 2", "L:", "addiu t0, zero, 3"],
   "init": {"a0": "0x1", "sp": "0x200000", "mem": {"0x00200004": "07000000"}},
   "expect": {"v1": "0x2", "t0": "0x3", "pc_trace": ["0x00100000", "0x00100008", "0x0010000c"]}, "source": "spec"},
  {"name": "bne taken", "asm": ["bne a0, a1, L", "addiu v0, v0, 1", "addiu v1, v1, 1", "L:"],
