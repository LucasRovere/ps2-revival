  {"name": "jr to an address outside the code is reported", "asm": ["jr a0", "nop"],
   "init": {"a0": "0x300000"}, "expect": {"error": "unknown jump target"}, "source": "spec"},
  {"name": "jump table, game shape (lui+addu+lw): first entry",
   "asm": ["sltiu at, a0, 3", "beq at, zero, DEFAULT", "sll a0, a0, 2", "lui at, 0x20", "addu at, at, a0", "lw at, 0x10(at)",
           "jr at", "nop", "C0:", "addiu v0, zero, 10", "j END", "nop", "C1:", "addiu v0, zero, 11", "j END", "nop",
           "C2:", "addiu v0, zero, 12", "j END", "nop", "DEFAULT:", "addiu v0, zero, -1", "END:"],
   "init": {"a0": "0x0", "mem": {"0x00200010": "200010002c00100038001000"}},
   "expect": {"at": "0x100020", "v0": "0xa",
              "pc_trace": ["0x00100000", "0x00100004", "0x00100008", "0x0010000c", "0x00100010", "0x00100014", "0x00100018",
                           "0x0010001c", "0x00100020", "0x00100024", "0x00100028"]}, "source": "spec"},
  {"name": "jump table, game shape: entry reached only through the table",
   "asm": ["sltiu at, a0, 3", "beq at, zero, DEFAULT", "sll a0, a0, 2", "lui at, 0x20", "addu at, at, a0", "lw at, 0x10(at)",
           "jr at", "nop", "C0:", "addiu v0, zero, 10", "j END", "nop", "C1:", "addiu v0, zero, 11", "j END", "nop",
           "C2:", "addiu v0, zero, 12", "j END", "nop", "DEFAULT:", "addiu v0, zero, -1", "END:"],
   "init": {"a0": "0x1", "mem": {"0x00200010": "200010002c00100038001000"}},
   "expect": {"a0": "0x4", "at": "0x10002c", "v0": "0xb"}, "source": "spec"},
  {"name": "jump table, game shape: last entry",
   "asm": ["sltiu at, a0, 3", "beq at, zero, DEFAULT", "sll a0, a0, 2", "lui at, 0x20", "addu at, at, a0", "lw at, 0x10(at)",
           "jr at", "nop", "C0:", "addiu v0, zero, 10", "j END", "nop", "C1:", "addiu v0, zero, 11", "j END", "nop",
           "C2:", "addiu v0, zero, 12", "j END", "nop", "DEFAULT:", "addiu v0, zero, -1", "END:"],
   "init": {"a0": "0x2", "mem": {"0x00200010": "200010002c00100038001000"}},
   "expect": {"a0": "0x8", "at": "0x100038", "v0": "0xc"}, "source": "spec"},
  {"name": "jump table, game shape: index out of range takes the bound check",
   "asm": ["sltiu at, a0, 3", "beq at, zero, DEFAULT", "sll a0, a0, 2", "lui at, 0x20", "addu at, at, a0", "lw at, 0x10(at)",
           "jr at", "nop", "C0:", "addiu v0, zero, 10", "j END", "nop", "C1:", "addiu v0, zero, 11", "j END", "nop",
           "C2:", "addiu v0, zero, 12", "j END", "nop", "DEFAULT:", "addiu v0, zero, -1", "END:"],
   "init": {"a0": "0x3", "mem": {"0x00200010": "200010002c00100038001000"}},
   "expect": {"a0": "0xc", "at": "0x0", "v0": "0xffffffffffffffff",
              "pc_trace": ["0x00100000", "0x00100004", "0x00100008", "0x00100044"]}, "source": "spec"},
  {"name": "jump table, SDK shape (lui+addiu+addu+lw 0)",
   "asm": ["sltiu v0, v1, 3", "beq v0, zero, DEFAULT", "lui v0, 0x20", "sll v1, v1, 2", "addiu v0, v0, -0x10",
           "addu v1, v1, v0", "lw a0, 0(v1)", "jr a0", "nop", "C0:", "addiu t0, zero, 10", "j END", "nop",
           "C1:", "addiu t0, zero, 11", "j END", "nop", "C2:", "addiu t0, zero, 12", "j END", "nop",
           "DEFAULT:", "addiu t0, zero, -1", "END:"],
