   "init": {"v1": "0x5", "mem": {"0x001ffff0": "24001000300010003c001000"}},
   "expect": {"v0": "0x200000", "t0": "0xffffffffffffffff", "pc_trace": ["0x00100000", "0x00100004", "0x00100008", "0x00100048"]},
   "source": "spec"},
  {"name": "jump table without a bound check",
   "asm": ["sll a0, a0, 2", "lui at, 0x20", "addu at, at, a0", "lw at, 0x10(at)", "jr at", "nop",
           "C0:", "addiu v0, zero, 10", "j END", "nop", "C1:", "addiu v0, zero, 11", "END:"],
   "init": {"a0": "0x1", "mem": {"0x00200010": "1800100024001000"}},
