   "expect": {"v0": "0x1ffff0", "v1": "0x1ffff4", "a0": "0x100030", "t0": "0xb"}, "source": "spec"},
  {"name": "jump table, SDK shape: out of range, the slot still runs",
   "asm": ["sltiu v0, v1, 3", "beq v0, zero, DEFAULT", "lui v0, 0x20", "sll v1, v1, 2", "addiu v0, v0, -0x10",
           "addu v1, v1, v0", "lw a0, 0(v1)", "jr a0", "nop", "C0:", "addiu t0, zero, 10", "j END", "nop",
           "C1:", "addiu t0, zero, 11", "j END", "nop", "C2:", "addiu t0, zero, 12", "j END", "nop",
