  {"name": "mult1 writes LO1/HI1 (bits 64-127) and rd, leaves LO/HI", "asm": ["mult1 v0, a0, a1"],
   "init": {"a0": "0xfffffffffffffffe", "a1": "0x3", "lo": "0x1234", "hi": "0x5678"},
   "expect": {"v0": "0xfffffffffffffffa", "lo": "0xfffffffffffffffa0000000000001234", "hi": "0xffffffffffffffff0000000000005678"},
   "source": "spec"},
  {"name": "multu1 is unsigned, rd = LO1", "asm": ["multu1 v0, a0, a1"],
